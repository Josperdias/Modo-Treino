{
  "expo": {
    "name": "Modo Treino",
    "slug": "modo-treino-josperd",
    "scheme": "modotreino",
    "version": "1.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/brand.png",
    "backgroundColor": "#F5F2EB",
    "primaryColor": "#162039",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "art.josperd.modotreino",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "art.josperd.modotreino",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand.png",
        "backgroundColor": "#F5F2EB"
      },
      "permissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "audio"
          ],
          "photosPermission": false,
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "appName": "Modo Treino",
      "author": "Josperd",
      "description": "Treinos A e B com ilustrações de Josperd e Camila Camomila"
    }
  }
}
