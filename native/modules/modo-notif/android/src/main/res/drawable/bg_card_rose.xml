<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:left="3dp" android:top="3dp">
    <shape android:shape="rectangle">
      <solid android:color="@color/mt_ink" />
      <corners android:radius="18dp" />
    </shape>
  </item>
  <item android:right="3dp" android:bottom="3dp">
    <shape android:shape="rectangle">
      <solid android:color="@color/mt_rose" />
      <stroke android:width="2dp" android:color="@color/mt_ink" />
      <corners android:radius="18dp" />
    </shape>
  </item>
  <item android:left="8dp" android:top="8dp" android:right="11dp" android:bottom="11dp">
    <bitmap android:src="@drawable/dots_rose" android:tileMode="repeat" />
  </item>
</layer-list>
