<?xml version="1.0" encoding="utf-8"?>
<!-- Treino (expandido): a ilustração do exercício, o nome, "Séries feitas" (ou o descanso) e os botões. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="12dp"
    android:paddingRight="17dp"
    android:paddingBottom="16dp"
    android:background="@drawable/bg_card_mint">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

    <ImageView
        android:id="@+id/art"
        android:layout_width="88dp"
        android:layout_height="116dp"
        android:padding="3dp"
        android:scaleType="fitCenter"
        android:background="@drawable/bg_art_frame"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="12dp"
        android:orientation="vertical">

      <TextView
          android:id="@+id/kicker"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="@font/dmsans_bold"
          android:includeFontPadding="false"
          android:letterSpacing="0.12"
          android:singleLine="true"
          android:ellipsize="end"
          android:textAllCaps="true"
          android:textColor="@color/mt_muted"
          android:textSize="11sp" />

      <TextView
          android:id="@+id/title"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="3dp"
          android:fontFamily="@font/barlow_black"
          android:includeFontPadding="false"
          android:maxLines="4"
          android:ellipsize="end"
          android:textAllCaps="true"
          android:textColor="@color/mt_ink"
          android:textSize="26sp" />
    </LinearLayout>
  </LinearLayout>

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:orientation="horizontal"
      android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/pill"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:layout_marginRight="2dp"
        android:gravity="center"
        android:paddingLeft="8dp"
        android:paddingRight="10dp"
        android:paddingBottom="2dp"
        android:background="@drawable/bg_pill_lime">

      <TextView
          android:id="@+id/pill_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/barlow_black"
          android:includeFontPadding="false"
          android:singleLine="true"
          android:ellipsize="end"
          android:textColor="@color/mt_ink"
          android:textSize="18sp" />

      <Chronometer
          android:id="@+id/clock"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/barlow_black"
          android:includeFontPadding="false"
          android:singleLine="true"
          android:textColor="@color/mt_ink"
          android:textSize="20sp"
          android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/primary"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginLeft="6dp"
        android:padding="13dp"
        android:scaleType="fitCenter"
        android:background="@drawable/bg_circle_yellow"
        android:src="@drawable/ic_check"
        android:contentDescription="Ação principal" />

    <ImageView
        android:id="@+id/secondary"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginLeft="6dp"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:background="@drawable/bg_circle_white"
        android:src="@drawable/ic_next"
        android:contentDescription="Próximo" />

    <ImageView
        android:id="@+id/open"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginLeft="6dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:background="@drawable/bg_circle_sage"
        android:src="@drawable/ic_more"
        android:contentDescription="Abrir o app" />
  </LinearLayout>
</LinearLayout>
