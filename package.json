{
  "name": "modo-treino",
  "version": "1.1.0",
  "private": true,
  "description": "Modo Treino — by Josperd. Site/PWA em site/, app Expo em native/. Este package.json só orquestra testes.",
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "test": "python3 tests/verify.py && node scripts/sync-shared.mjs --check && node --test \"tests/*.test.mjs\"",
    "test:e2e": "node --test tests/e2e/site.e2e.mjs",
    "serve": "python3 -m http.server 8000 -d site"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=22"
  }
}
